                                "name": "dialogues",
                                "data": {
                                    "__variant_value": {
                                        "list": [
                                            {
                                                "__variant_value": "AAAHH ICARUS, its a pleasure that we finally meet",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "I bid you welcome to my abode",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "It is not much of now",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "But soon we will use her blood to fuel this war machine",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "Come to Save your goddess?",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "I hope you understand what I AM doing is for the good of both of us",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "For all of us",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "Traitor!",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "How dare you side with the gods?",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "Do you know, HOW long we have waited for this moment!",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "You are welcome to try",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "But do not expect me to show you any mercy",
                                                "__variant_type": 7
                                            }
                                        ],
                                        "enumListType": "",
                                        "index": 7
                                    },
                                    "__variant_type": 20
                                }
                            },
