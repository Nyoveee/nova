                        "scriptId": 8330190978169727947,
                        "fields": [
                            {
                                "name": "weaverVoiceoverTexts",
                                "data": {
                                    "__variant_value": {
                                        "list": [
                                            {
                                                "__variant_value": "Traitor! How dare you side with the gods? ",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "Look around you! ",
                                                "__variant_type": 7
                                            },
                                            {
                                                "__variant_value": "The souls of the dead cry out for vengeance",
                                                "__variant_type": 7
